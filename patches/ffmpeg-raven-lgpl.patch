--- ffmpeg-7.1.orig/libavformat/tls_securetransport.c	2026-10-02 17:39:09
+++ ffmpeg-7.1/libavformat/tls_securetransport.c	2026-10-02 17:39:09
@@ -16,6 +16,14 @@
  * You should have received a copy of the GNU Lesser General Public License
  * along with FFmpeg; if not, write to the Free Software * Foundation, Inc.,
